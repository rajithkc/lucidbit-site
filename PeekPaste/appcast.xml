<?xml version="1.0" standalone="yes"?>
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     version="2.0">
    <channel>
        <title>PeekPaste Updates</title>
        <description>Direct-distribution update feed for PeekPaste.</description>
        <language>en</language>
        <link>https://lucidbit.app/PeekPaste/appcast.xml</link>
        <!--
            Sparkle reads this feed daily per running app instance.
            Add new releases as <item> blocks inside <channel>; the
            order doesn't matter, Sparkle picks the highest
            sparkle:version it sees. release.sh prints a ready-to-paste
            block including the EdDSA signature, file length, and pubDate.

            EdDSA public key (matches SUPublicEDKey injected at build time,
            shared across LucidBit apps):
              flxF/Hg9ws46PE3BxiJGtHZ+uPAc/1oRnRlznwKVLyI=

            Item template, for reference:

            <item>
                <title>Version 1.0</title>
                <pubDate>Sat, 22 Aug 2026 14:21:48 +0000</pubDate>
                <sparkle:version>2</sparkle:version>
                <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
                <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
                <description><![CDATA[
                    <h2>What's new</h2>
                    <ul><li>Initial release of PeekPaste.</li></ul>
                ]]></description>
                <enclosure
                    url="https://lucidbit.app/downloads/PeekPaste-1.0.dmg"
                    sparkle:edSignature="…"
                    length="…"
                    type="application/octet-stream" />
            </item>
        -->
        <item>
            <title>Version 1.0</title>
            <pubDate>Mon, 07 Sep 2026 15:43:39 +0000</pubDate>
            <!--
                Build 4 replaces build 3 rather than being added beside it.

                Both builds use PeekPaste-1.0.dmg, so the new upload replaced the
                bytes referenced by build 3. Keeping the old item would leave an
                invalid signature and length in the feed.
            -->
            <sparkle:version>4</sparkle:version>
            <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[
                <h2>What's new in 1.0</h2>
                <ul>
                    <li>Single-click now selects a clip and double-click pastes it.</li>
                    <li>Image cards can be selected consistently in both the edge panel and Library.</li>
                    <li>Direct Paste setup and the manual Command-V fallback are clearer.</li>
                </ul>
            ]]></description>
            <enclosure
                url="https://lucidbit.app/downloads/PeekPaste-1.0.dmg"
                sparkle:edSignature="xtQPn2v0BbOFpQxl+39Ala0IuYHwhrTgxf05heVYx3yiI4leHJygnDzL87koLFbDhhJOxR1AYbiqHYp+uH2BAw==" length="11087664"
                type="application/octet-stream" />
        </item>
    </channel>
